<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Prom with Me, Abby?</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      max-width: 400px;
    }

    h1 {
      margin-bottom: 20px;
    }

    button {
      font-size: 18px;
      padding: 10px 20px;
      margin: 10px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }

    .yes {
      background-color: #4CAF50;
      color: white;
    }

    .no {
      background-color: #f44336;
      color: white;
    }

    img {
      max-width: 100%;
      margin-top: 20px;
      border-radius: 10px;
    }
  </style>
</head>
<body>

  <div class="card" id="card">
    <h1>Abby, will you go to prom with me? 💃🕺</h1>
    <button class="yes" onclick="sayYes()">Yes</button>
    <button class="no" onclick="sayNo()">No</button>
  </div>

  <script>
    function sayYes() {
      document.getElementById("card").innerHTML = `
        <h1>Abby said YES!!! 🎉😍</h1>
        <p>Prom is about to be legendary.</p>
        <img src="https://i.imgflip.com/4/3vzej.jpg" alt="Happy meme">
      `;
    }

    function sayNo() {
      alert("Nice try Abby 😤 click YES");
    }
  </script>

</body>
</html>
